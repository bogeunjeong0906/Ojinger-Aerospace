{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vessel params.json schema",
  "description": "Schema for telemetry exported by src/vessel/export.ks (vessel/params.json).\nUsed by solver engines to build a simple vehicle model.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "description": "Vessel name or identifier" },
    "total_stages": { "type": "integer", "minimum": 0, "description": "Total number of stages (including current and remaining)" },
    "current_stage": { "type": "integer", "minimum": 0, "description": "Index (0-based) of the current/active stage" },
    "mass": { "type": "number", "minimum": 0.0, "description": "Current total mass of the vessel (kg)" },
    "altitude": { "type": "number", "description": "Optional: current altitude (m)" },
    "velocity": { "type": "number", "description": "Optional: current vertical speed (m/s)" },
    "stages": {
      "type": "array",
      "description": "Per-stage summary (index ascending or 0..N-1)",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "stage": { "type": "integer", "description": "stage index (0-based)" },
          "fuel": { "type": "number", "minimum": 0.0, "description": "Estimated fuel/propellant mass in this stage (kg)" },
          "thrust": { "type": "number", "minimum": 0.0, "description": "Available thrust for the stage (newtons)" },
          "deltaV": { "type": "number", "minimum": 0.0, "description": "Estimated delta-v available for this stage (m/s)" },
          "isp": { "type": "number", "minimum": 0.0, "description": "Specific impulse for engines in this stage (s). Optional but recommended." }
        },
        "required": ["stage", "fuel", "thrust"]
      }
    },
    "notes": { "type": "string", "description": "Optional freeform notes or exporter version" }
  },
  "required": ["id", "total_stages", "current_stage", "mass", "stages"],
  "examples": [
    {
      "id": "VEHICLE-1",
      "total_stages": 3,
      "current_stage": 2,
      "mass": 15234.5,
      "stages": [
        { "stage": 0, "fuel": 1200.0, "thrust": 0.0, "deltaV": 0.0 },
        { "stage": 1, "fuel": 4500.0, "thrust": 200000.0, "deltaV": 3500.0, "isp": 320.0 },
        { "stage": 2, "fuel": 8000.0, "thrust": 450000.0, "deltaV": 7500.0, "isp": 340.0 }
      ]
    }
  ]
}
